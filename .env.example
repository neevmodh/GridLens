# Local app works without credentials. Copy this file to .env for live QuickML.
QUICKML_ENDPOINT_URL=
QUICKML_ENDPOINT_KEY=
ZOHO_ORG_ID=
QUICKML_ENVIRONMENT=Development
# oauth for local/evaluator use; catalyst for requests hosted behind AppSail.
QUICKML_AUTH_MODE=oauth
# Required with managed authentication; verifies the gateway's project identity.
QUICKML_PROJECT_ID=

# Option A: short-lived access token (do not use for the final submission).
ZOHO_ACCESS_TOKEN=
# Option B: automatic refresh; recommended for a lasting public demo.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Match the request example in your published QuickML endpoint console.
# raw: original timestamp + three weather columns.
# engineered: data/quickml_training.csv produced by scripts/prepare_quickml.py.
QUICKML_FEATURE_SCHEMA=raw
# single: one record per API call, up to 4 simultaneous requests.
# batch: one list per API call; enable only if supported by your endpoint.
QUICKML_REQUEST_MODE=single
# The official QuickML prediction API wraps features in data.
# Override only when your published endpoint's sample requires another shape.
QUICKML_INPUT_KEY=data

# Never enable this for the real submission. It is only for the local self-test.
PREDICT_ALLOW_LOCAL=0

# Optional: local SQLite run history. AppSail filesystem is not durable storage.
# GRIDLENS_DATA_DIR=/tmp/gridlens
# Exact public website origin when Catalyst forwards a different internal Host.
# GRIDLENS_PUBLIC_ORIGIN=https://your-app.development.catalystappsail.in
# Durable Catalyst history table; keep empty for local SQLite development.
# GRIDLENS_HISTORY_TABLE=92358000000019001
